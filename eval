#!/bin/bash
# eval — run EvalPlus (HumanEval+/MBPP+) against the local llama-server,
# in a background-friendly way. Depends on the python venv at ./eval-venv
# (created on first run) and a running server (default localhost:8080,
# model qwen3.8-27b-fp4-mtp).
#
# EvalPlus runs an execution-graded pass@1, both on the original tests
# ("base") and on its strengthened extra tests ("+"). These are the
# contamination-aware-ish numbers people actually cite for coding models.
# Reference points:
#   HumanEval+ / MBPP+  — strong frontier ~85-95%+ / ~80-90%
#   (our 27B FP4 local model is a strict, deterministic subset of the
#    self-reported BF16 numbers, e.g. LiveCodeBench v6 90.3% @ xhigh)
#
# Usage:
#   ./eval                                     # HumanEval+ (foreground)
#   ./eval --bg                                # run in background, log + summary
#   ./eval --dataset mbpp                      # MBPP+ instead
#   ./eval --bg --dataset humaneval --dataset mbpp
#   ./eval --bench livecodebench [--release_version release_latest]
#   ./eval --bench livecodebench --start_date 2024-01-01 --end_date 2024-06-01
#   ./eval --port 8080 --model qwen3.8-27b-fp4-mtp
#   ./eval --n_samples 5 --temperature 0.6     # sampling pass (non-deterministic)
#   ./eval --parallel 24                       # grading workers (<= #cores)
#   ./eval --root /tmp/eval-r2                 # explicit run dir (default eval-runs/run-<ts>)
#   ./eval --status [DIR]                      # print summary of a previous run
#
# Real numbers: every run gets its own dir eval-runs/run-<timestamp>/ so a
# rerun never clobbers previous samples (codegen resume only appends).
# Ground-truth oracle outputs are computed once and cached under eval-runs/.
#
# Background: `--bg` writes eval-runs/run-<ts>/eval.log and a summary to
# eval-runs/run-<ts>/summary.txt; poll with `./eval --status eval-runs/run-<ts>/`.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV="$SCRIPT_DIR/eval-venv"
ROOT=""
DATASETS=()
PORT=8080
HOST=localhost
MODEL=qwen3.8-27b-fp4-mtp
N_SAMPLES=1
TEMPERATURE=0.0
PARALLEL=24
BG=0
STATUS=""
BENCH="evalplus"           # evalplus | livecodebench
RELEASE_VERSION=release_latest
START_DATE=""
END_DATE=""
DEBUG=0

if [[ -f "$SCRIPT_DIR/.eval.env" ]]; then
  # shellcheck disable=SC1091
  source "$SCRIPT_DIR/.eval.env"
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    --bg)             BG=1;            shift;;
    --host)           HOST=$2;         shift 2;;
    --port)           PORT=$2;         shift 2;;
    --model)          MODEL=$2;        shift 2;;
    --dataset)        DATASETS+=("$2"); shift 2;;
    --n_samples)      N_SAMPLES=$2;    shift 2;;
    --temperature)    TEMPERATURE=$2;  shift 2;;
    --parallel|-p)    PARALLEL=$2;     shift 2;;
    --root)           ROOT=$2;         shift 2;;
    --status)         STATUS=$2;       shift 2;;
    --bench)          BENCH=$2;        shift 2;;
    --release_version) RELEASE_VERSION=$2; shift 2;;
    --start_date)     START_DATE=$2;   shift 2;;
    --end_date)       END_DATE=$2;     shift 2;;
    --debug)          DEBUG=1;         shift;;
    -h|--help)        grep '^#' "$0" | grep -v '^#!/' | sed 's/^#\s\?//'; exit 0;;
    *) echo "unknown arg: $1" >&2; exit 1;;
  esac
done

[[ ${#DATASETS[@]} -eq 0 ]] && DATASETS=(humaneval)
case "$BENCH" in
  evalplus|livecodebench) ;;
  *) echo "unknown bench: $BENCH (evalplus|livecodebench)" >&2; exit 1;;
esac

run_summary() {
  local dir="$1"
  [[ -d "$dir" ]] || { echo "no such run dir: $dir" >&2; return 1; }
  find "$dir" -name '*_eval_results.json' -print0 | while IFS= read -r -d '' f; do
    python3 - "$f" <<'PY'
import json, os, sys
p = sys.argv[1]
r = json.load(open(p))
for part in os.path.dirname(p).split("/"):
    if part in ("humaneval", "mbpp"):
        dset = part
base = plus = 0
for arr in r.get("eval", {}).values():
    if arr and arr[-1]["base_status"] == "pass":
        base += 1
    if arr and arr[-1]["base_status"] == "pass" and arr[-1]["plus_status"] == "pass":
        plus += 1
n = len(r.get("eval", {}))
print(f"{dset:10s} base pass@1 {base/n:6.2%}   + pass@1 {plus/n:6.2%}   ({n} tasks, {r.get('date','?')})")
PY
  done
}

LCB_SUMMARY=""
lcb_summary() {
  local dir="$1"
  [[ -d "$dir" ]] || { echo "no such run dir: $dir" >&2; return 1; }
  find "$dir" -name '*_eval.json' ! -name '*_eval_all.json' -print0 | while IFS= read -r -d '' f; do
    python3 - "$f" <<'PY'
import json, sys
p = sys.argv[1]
r = json.load(open(p))
m = r[0] if isinstance(r, list) and r else r
p1 = m.get("pass@1", "?")
try:
    p1 = f"{float(p1):6.2%}"
except Exception:
    pass
detail = m.get("detail", {})
by = {k: (f"{float(v.get('pass@1')):.2%}" if v.get("pass@1") is not None else "?") for k, v in detail.items() if isinstance(v, dict)}
print(f"livecodebench pass@1 {p1}   per-platform: {by}")
PY
  done
}

if [[ -n "$STATUS" ]]; then
  case "$BENCH" in
    livecodebench) lcb_summary "$STATUS";;
    *) run_summary "$STATUS";;
  esac
  exit 0
fi

if ! command -v curl >/dev/null; then
  echo "curl required" >&2; exit 1
fi

if [[ ! -x "$VENV/bin/evalplus.evaluate" ]]; then
  echo "==> bootstrapping eval-venv (evalplus + deps) ..."
  python3 -m venv "$VENV"
  "$VENV/bin/pip" install -q --upgrade pip
  "$VENV/bin/pip" install -q evalplus
  echo "    venv ready at $VENV"
fi

URL="http://$HOST:$PORT/v1/models"
echo -n "==> checking server $URL ... "
if ! curl -s --max-time 5 -o /dev/null "$URL"; then
  echo "FAILED (is llama-server running on $HOST:$PORT?)" >&2; exit 1
fi
echo "ok"

if [[ -z "$ROOT" ]]; then
  ROOT="$SCRIPT_DIR/eval-runs/run-$(date +%Y%m%d-%H%M%S)"
fi
mkdir -p "$ROOT"

run_one() {
  local dset="$1"
  echo "==> $dset  model=$MODEL  n=$N_SAMPLES temp=$TEMPERATURE parallel=$PARALLEL"
  echo "    samples -> $ROOT/$dset/"
  if [[ "$N_SAMPLES" -eq 1 && "$TEMPERATURE" == "0.0" ]]; then
    # greedy: do_sample=False (one deterministic pass@1, temp forced 0)
    GREEDY="--greedy"
  else
    GREEDY=""
  fi
  "$VENV/bin/evalplus.evaluate" "$dset" \
    --model "$MODEL" \
    --backend openai \
    --base_url "http://$HOST:$PORT/v1" \
    --root "$ROOT" \
    --n_samples "$N_SAMPLES" \
    --temperature "$TEMPERATURE" \
    --parallel "$PARALLEL" \
    $GREEDY
}

run_lcb() {
  local dts="$START_DATE" det="$END_DATE"
  echo "==> livecodebench  model=$MODEL  release=$RELEASE_VERSION n=$N_SAMPLES temp=$TEMPERATURE parallel=$PARALLEL"
  [ -n "$dts" ] && echo "    date window: $dts .. $det"
  [ -n "$dts" ] && DATERANGE=(--start_date "$dts" --end_date "$det") || DATERANGE=()
  local debugflag=()
  [[ $DEBUG -eq 1 ]] && debugflag=(--debug)
  ( cd "$SCRIPT_DIR/eval-venv/LiveCodeBench" && \
    LCB_DATA_DIR="$SCRIPT_DIR/eval-runs/lcb-data" \
    LCB_RUN_DIR="$ROOT" \
    LCB_SUMMARY_DIR="$ROOT" \
    OPENAI_KEY=local \
    OPENAI_BASE_URL="http://$HOST:$PORT/v1" \
      "$VENV/bin/python" -m lcb_runner.runner.main \
        --model "$MODEL" \
        --scenario codegeneration \
        --release_version "$RELEASE_VERSION" \
        --n "$N_SAMPLES" \
        --temperature "$TEMPERATURE" \
        --multiprocess "$PARALLEL" \
        --evaluate \
        --num_process_evaluate "$PARALLEL" \
        "${DATERANGE[@]}" \
        "${debugflag[@]}" \
  )
  # harvest results into the run dir (runner writes output/ under its CWD)
  cp "$SCRIPT_DIR/eval-venv/LiveCodeBench"/output/"$MODEL"*/*codegeneration*.json "$ROOT"/ 2>/dev/null \
    && echo "    results copied to $ROOT/" || echo "    ! no output json found"
  echo "    (eval json: $(ls "$ROOT"/*_eval.json 2>/dev/null | wc -l) file(s))"
}

if [[ $BG -eq 1 ]]; then
  LOG="$ROOT/eval.log"
  {
    if [[ "$BENCH" == "livecodebench" ]]; then
      run_lcb
    else
      for dset in "${DATASETS[@]}"; do
        run_one "$dset"
      done
      echo
      echo "=== SUMMARY ==="
      run_summary "$ROOT"
    fi
    echo "=== DONE $(date -u +%Y-%m-%dT%H:%MZ) ==="
  } >"$LOG" 2>&1 &
  BGPID=$!
  echo "launched in background: pid=$BGPID  log=$LOG"
  echo "poll: ./eval --bench $BENCH --status $ROOT"
  echo "kill: kill $BGPID"
else
  if [[ "$BENCH" == "livecodebench" ]]; then
    run_lcb
    echo
    echo "=== SUMMARY ==="
    lcb_summary "$ROOT"
  else
    for dset in "${DATASETS[@]}"; do
      run_one "$dset"
    done
    echo
    echo "=== SUMMARY ==="
    run_summary "$ROOT"
  fi
fi