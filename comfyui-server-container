#!/bin/bash
# Container-side wrapper for ComfyUI image generation server.
# Starts ComfyUI and the OpenAI-compatible bridge (which also serves MCP).
#
# The bridge selects a workflow at request time based on the `model` field
# in each POST /v1/images/generations request — no preset arg required.
#
# Usage: comfyui-server-container [extra ComfyUI args]
#
# Environment variables (all optional):
#   COMFYUI_CONFIG_DIR    - Config directory (default: ~/.config/comfyui)
#   COMFYUI_DIR           - ComfyUI install directory (default: ~/ComfyUI)
#   COMFYUI_PORT          - ComfyUI internal port (default: 8188)
#   COMFYUI_BRIDGE_PORT   - Bridge external port (default: 8082)
#   WORKFLOW_DIR          - Path to workflow JSON templates (default: $CONFIG_DIR/workflows)
#   BRIDGE_BASE_URL       - Public base URL for image URLs (default: http://localhost:8082)
#   IMAGE_DIR             - Where to store generated images (default: ~/images/generated)
#   IMAGE_RETENTION_DAYS  - Days to keep images (default: 7)

set -e

CONFIG_DIR="${COMFYUI_CONFIG_DIR:=${XDG_CONFIG_HOME:=$HOME/.config}/comfyui}"
WORKFLOW_DIR="${WORKFLOW_DIR:-$CONFIG_DIR/workflows}"

# ROCm env vars for Strix Halo unified memory.
if [[ -d /opt/rocm ]]; then
    export GGML_CUDA_ENABLE_UNIFIED_MEMORY="${GGML_CUDA_ENABLE_UNIFIED_MEMORY:-1}"
    export GPU_MAX_HW_QUEUES="${GPU_MAX_HW_QUEUES:-2}"
    export LLAMA_SET_ROWS="${LLAMA_SET_ROWS:-1}"
fi

COMFYUI_DIR="${COMFYUI_DIR:=${HOME}/ComfyUI}"
BRIDGE_PORT="${COMFYUI_BRIDGE_PORT:-8082}"
COMFYUI_PORT="${COMFYUI_PORT:-8188}"

# Ensure ComfyUI is installed
if [[ ! -d "$COMFYUI_DIR" ]]; then
    echo "Error: ComfyUI not found at $COMFYUI_DIR"
    echo "Run the setup script first: ./scripts/setup-comfyui-container.sh"
    exit 1
fi

# Ensure workflow directory exists
if [[ ! -d "$WORKFLOW_DIR" ]]; then
    echo "Error: Workflow directory not found: $WORKFLOW_DIR"
    echo "Sync workflows from host first (comfyui-server does this automatically)."
    exit 1
fi

echo "Starting ComfyUI image server"
echo "Workflows: $WORKFLOW_DIR"
echo "  Available: $(ls -1 "$WORKFLOW_DIR"/*.json 2>/dev/null | xargs -n1 basename -s .json | tr '\n' ' ' || echo "(none)")"
echo "ComfyUI port: $COMFYUI_PORT"
echo "Bridge port:  $BRIDGE_PORT"
echo ""

# Kill any leftover processes from a previous run before starting new ones.
# This is necessary because distrobox shares the host network namespace —
# background processes survive service restarts and keep ports bound.
# We kill by port so we don't accidentally kill the process we're about to start.
if ss -tlnp | grep -q ":${COMFYUI_PORT}"; then
    echo "Port ${COMFYUI_PORT} in use — killing previous ComfyUI instance..."
    fuser -k -TERM "${COMFYUI_PORT}/tcp" 2>/dev/null || true
    sleep 2
    fuser -k -KILL "${COMFYUI_PORT}/tcp" 2>/dev/null || true
fi
if ss -tlnp | grep -q ":${BRIDGE_PORT}"; then
    echo "Port ${BRIDGE_PORT} in use — killing previous bridge instance..."
    fuser -k -TERM "${BRIDGE_PORT}/tcp" 2>/dev/null || true
    sleep 1
    fuser -k -KILL "${BRIDGE_PORT}/tcp" 2>/dev/null || true
fi

# Use system Python with user site-packages (PyTorch+ROCm pre-installed in container)
PYTHON="${COMFYUI_PYTHON:-python3}"

# Add venv site-packages to PYTHONPATH so ComfyUI can find torch+rocm
VENV_SITE="/opt/venv/lib/python3.12/site-packages"
export PYTHONPATH="${VENV_SITE}:${PYTHONPATH}"

# Point ComfyUI at the central model store via extra_model_paths.yaml if present
# (synced in by the host wrapper). Avoids per-file symlinks under ComfyUI/models.
EXTRA_PATHS_ARG=()
EXTRA_PATHS_FILE="$CONFIG_DIR/extra_model_paths.yaml"
if [[ -f "$EXTRA_PATHS_FILE" ]]; then
    EXTRA_PATHS_ARG=(--extra-model-paths-config "$EXTRA_PATHS_FILE")
    echo "Model paths: $EXTRA_PATHS_FILE"
fi

# Start ComfyUI in the background
cd "$COMFYUI_DIR"
$PYTHON main.py \
    --listen 0.0.0.0 \
    --port "$COMFYUI_PORT" \
    --disable-xformers \
    "${EXTRA_PATHS_ARG[@]}" \
    "$@" &

COMFYUI_PID=$!

# Wait for ComfyUI to be ready
for i in {1..60}; do
    if curl -s "http://127.0.0.1:${COMFYUI_PORT}/system_stats" > /dev/null 2>&1; then
        echo "ComfyUI ready on port $COMFYUI_PORT"
        break
    fi
    if ! kill -0 $COMFYUI_PID 2>/dev/null; then
        echo "Error: ComfyUI exited unexpectedly"
        exit 1
    fi
    sleep 1
done

# Start the bridge (serves OpenAI-compat API + MCP tool on same port)
BRIDGE_SCRIPT="${HOME}/.local/bin/comfyui-bridge.py"
if [[ -f "$BRIDGE_SCRIPT" ]]; then
    # Ensure the bridge port is free immediately before starting.
    # This covers the race where the previous bridge process is still shutting
    # down when this script runs (distrobox shares host network namespace).
    for _attempt in 1 2 3; do
        if ss -tlnp | grep -q ":${BRIDGE_PORT}"; then
            echo "Port ${BRIDGE_PORT} still in use (attempt ${_attempt}/3) — waiting..."
            fuser -k -KILL "${BRIDGE_PORT}/tcp" 2>/dev/null || true
            sleep 2
        else
            break
        fi
    done

    echo "Starting OpenAI + MCP bridge on port $BRIDGE_PORT"
    WORKFLOW_DIR="$WORKFLOW_DIR" \
    BRIDGE_BASE_URL="${BRIDGE_BASE_URL:-http://${HOST_HOSTNAME:-$(hostname -f)}:$BRIDGE_PORT}" \
    IMAGE_DIR="${IMAGE_DIR:-$HOME/images/generated}" \
    IMAGE_RETENTION_DAYS="${IMAGE_RETENTION_DAYS:-7}" \
    COMFYUI_HOST="127.0.0.1" \
    COMFYUI_PORT="$COMFYUI_PORT" \
    BRIDGE_PORT="$BRIDGE_PORT" \
        $PYTHON "$BRIDGE_SCRIPT" &
    BRIDGE_PID=$!
    wait $COMFYUI_PID
else
    echo "Warning: bridge script not found at $BRIDGE_SCRIPT"
    echo "ComfyUI running without OpenAI API bridge."
    wait $COMFYUI_PID
fi
