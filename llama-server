#!/bin/bash
# Universal llama.cpp server launcher for distrobox containers
# Supports both ROCm and Vulkan backends
# 
# Usage: llama-server <backend> <model-config> [additional-args]
# Example: llama-server rocm qwen3-coder-30b --port 8000
#          llama-server vulkan devstral-small-24b --port 8080

set -e

# Backend configuration
declare -A BACKENDS=(
    [rocm]="llama-rocm-7.14|docker.io/kyuz0/amd-strix-halo-toolboxes:rocm-7.14"
    [vulkan]="vulkan-radv|docker.io/kyuz0/amd-strix-halo-toolboxes:vulkan-radv"
)

# Parse backend
BACKEND="${1:-rocm}"
if [[ ! ${BACKENDS[$BACKEND]+_} ]]; then
    echo "Error: Unknown backend '$BACKEND'"
    echo "Available backends: ${!BACKENDS[@]}"
    exit 1
fi

# Extract config for the backend
IFS='|' read -r CONTAINER_NAME IMAGE <<< "${BACKENDS[$BACKEND]}"
WRAPPER_SCRIPT="llama-server-container"
shift

# Config directory - support environment variable override
# Default: ./configs (relative to this script)
# Override with: LLAMA_CONFIG_DIR environment variable
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_DIR="${LLAMA_CONFIG_DIR:=$SCRIPT_DIR/configs}"

# Parse model config
MODEL_CONFIG="${1:-}"

# If no model config provided, show available configs
if [[ -z "$MODEL_CONFIG" ]]; then
    echo "Usage: llama-server <backend> <model-config> [additional-args]"
    echo ""
    echo "Available backends: rocm, vulkan"
    echo ""
    echo "Available model presets in $CONFIG_DIR:"
    if [[ -d "$CONFIG_DIR" ]]; then
        ls -1 "$CONFIG_DIR"/*.ini 2>/dev/null | while read -r ini; do
            basename=$(basename "$ini" .ini)
            echo "  - $basename"
        done
    else
        echo "  (config directory does not exist)"
    fi
    exit 0
fi

shift

CONFIG_FILE="$CONFIG_DIR/${MODEL_CONFIG}.ini"

# Check if preset file exists
if [[ ! -f "$CONFIG_FILE" ]]; then
    echo "Error: Preset file not found: $CONFIG_FILE"
    echo ""
    echo "Available model presets in $CONFIG_DIR:"
    if [[ -d "$CONFIG_DIR" ]]; then
        ls -1 "$CONFIG_DIR"/*.ini 2>/dev/null | while read -r ini; do
            basename=$(basename "$ini" .ini)
            echo "  - $basename"
        done
    else
        echo "  (config directory does not exist)"
    fi
    exit 1
fi

# Check if container exists, if not create it.
# Field-based match: distrobox pads table columns dynamically, so grepping
# for "| $NAME |" breaks across versions/container sets.
if ! distrobox list 2>/dev/null | sed 1d | cut -d'|' -f2 | tr -d ' ' | grep -Fxq "$CONTAINER_NAME"; then
    echo "Container $CONTAINER_NAME not found. Creating with $IMAGE..."
    distrobox create -n "$CONTAINER_NAME" \
        --image "$IMAGE" \
        --additional-flags "--device /dev/kfd --device /dev/dri --group-add video --group-add render --security-opt seccomp=unconfined" \
        || echo "Container $CONTAINER_NAME already exists, continuing setup."
    
    # Setup wrapper script and configs
    distrobox enter "$CONTAINER_NAME" -- bash -c 'mkdir -p ~/.local/bin ~/.config/llama-cpp'
    cat "$(dirname "$0")/llama-server-container" | distrobox enter "$CONTAINER_NAME" -- bash -c "cat > ~/.local/bin/$WRAPPER_SCRIPT && chmod +x ~/.local/bin/$WRAPPER_SCRIPT"
    
    for ini in "$CONFIG_DIR"/*.ini; do
        cat "$ini" | distrobox enter "$CONTAINER_NAME" -- bash -c "cat > ~/.config/llama-cpp/$(basename "$ini")"
    done
    for jinja in "$CONFIG_DIR"/*.jinja; do
        [[ -f "$jinja" ]] || continue
        cat "$jinja" | distrobox enter "$CONTAINER_NAME" -- bash -c "cat > ~/.config/llama-cpp/$(basename "$jinja")"
    done
    
    echo "Container setup complete!"
fi

# Add default --host if not specified
if [[ ! " $@ " =~ " --host " ]]; then
    set -- "$@" "--host" "0.0.0.0"
fi

# Optional CLI port override (the q38rocm fork ignores `port` in preset INIs,
# so its wrapper sets LLAMA_SERVER_PORT and we append it here)
if [[ -n "${LLAMA_SERVER_PORT:-}" ]] && [[ ! " $@ " =~ " --port " ]]; then
    set -- "$@" "--port" "${LLAMA_SERVER_PORT}"
fi

# Container init can race service start at boot: the first distrobox exec
# after the container comes up may hang indefinitely. Probe until entry
# responds; on persistent failure exit non-zero so Restart= kicks in.
probe_ok=0
for _ in $(seq 1 36); do
    if timeout 15 distrobox enter "$CONTAINER_NAME" -- true 2>/dev/null; then
        probe_ok=1
        break
    fi
    sleep 5
done
if [[ "$probe_ok" -ne 1 ]]; then
    echo "Error: container $CONTAINER_NAME is not accepting execs; aborting (will retry)." >&2
    exit 1
fi

# Launch server (use full path since non-login shells may not have ~/.local/bin
# in PATH; expand on the host — distrobox ≥1.8 no longer expands \$HOME and
# container $HOME is identical to host $HOME anyway)
distrobox enter "$CONTAINER_NAME" -- "$HOME/.local/bin/$WRAPPER_SCRIPT" "$MODEL_CONFIG" "$@"
