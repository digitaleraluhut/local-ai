[Unit]
Description=ComfyUI image generation server - %i (ROCm)
After=default.target

[Service]
Type=exec
ExecStart=%h/local-ai/comfyui-server %i

# ComfyUI and the bridge run inside the distrobox container's cgroup,
# not this unit's, so KillMode= can't reach them directly.
# Best-effort SIGKILL on the in-container processes by name.
# comfyui-server-container also kills leftover processes at startup.
ExecStopPost=-/usr/bin/pkill --signal SIGKILL -f "main.py.*--port.*8188"
ExecStopPost=-/usr/bin/pkill --signal SIGKILL -f "comfyui-bridge.py"
TimeoutStopSec=15

Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
